            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"vehicleNumber\": \"DUP-0001\",\n  \"vehicleType\": \"CAR\",\n  \"brand\": \"Toyota\",\n  \"model\": \"Camry\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vehicles"
              ]
            },
            "description": "Run this request twice. The second call returns 409 Conflict because the vehicle number is already registered."
          },
          "response": []
        },
        {
          "name": "Vehicle Already Inside",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}/entry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vehicles",
                "{{vehicleId}}",
