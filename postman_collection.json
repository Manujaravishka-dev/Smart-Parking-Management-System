              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vehicles",
                "{{vehicleId}}",
                "exit"
              ]
            },
            "description": "Simulate vehicle exit. Vehicle must be INSIDE. Sets status OUTSIDE and stores exitTime. Returns 409 if not currently INSIDE."
          },
          "response": []
        }
      ]
    },
    {
