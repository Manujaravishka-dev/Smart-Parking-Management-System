              ],
              "path": [
                "api",
                "parking",
                "spaces"
              ],
              "query": [
                {
                  "key": "zone",
                  "value": "Zone-A",
                  "description": "Exact zone (case-insensitive)"
                }
              ]
            },
            "description": "Search spaces by zone (case-insensitive exact match). Returns 200 with the matching spaces."
          },
          "response": []
        },
        {
          "name": "Search Available",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/parking/spaces?available=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parking",
                "spaces"
              ],
              "query": [
                {
                  "key": "available",
                  "value": "true",
                  "description": "true = only AVAILABLE spaces, false = only non-available"
