                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parking",
                "spaces",
                "{{spaceId}}"
              ]
            },
            "description": "Partially update space fields (ownerId, spaceNumber, location, city, zone, pricePerHour). Fields omitted are left unchanged. Returns 200."
