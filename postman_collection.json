    },
    {
      "name": "Reservation",
      "item": [
        {
          "name": "Create Reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"vehicleId\": 1,\n  \"parkingSpaceId\": 1,\n  \"startTime\": \"2026-08-15T10:00:00\",\n  \"endTime\": \"2026-08-15T12:00:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/parking/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parking",
                "reservations"
              ]
            },
            "description": "Reserve an AVAILABLE parking space. The space becomes RESERVED and the reservation is CONFIRMED. Returns 201, or 409 if the space is not available, or 400 if startTime is not before endTime."
          },
          "response": []
        },
        {
          "name": "Get Reservation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/parking/reservations/{{reservationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parking",
                "reservations",
                "{{reservationId}}"
              ]
            },
            "description": "Retrieve a reservation by id. Returns 200, or 404 if not found."
          },
          "response": []
        },
        {
          "name": "Get User Reservations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/parking/reservations/user/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parking",
                "reservations",
                "user",
                "{{userId}}"
              ]
            },
            "description": "List all reservations belonging to a user. Returns 200 with an array (possibly empty)."
          },
          "response": []
        },
        {
          "name": "Cancel Reservation",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/parking/reservations/{{reservationId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parking",
                "reservations",
                "{{reservationId}}",
                "cancel"
              ]
            },
            "description": "Cancel a reservation. Reservation becomes CANCELLED and the space returns to AVAILABLE. Returns 200, or 409 if already cancelled/completed."
          },
          "response": []
        },
        {
          "name": "Release Reservation",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/parking/reservations/{{reservationId}}/release",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parking",
                "reservations",
                "{{reservationId}}",
                "release"
              ]
            },
            "description": "Complete/release a reservation. Reservation becomes COMPLETED and the space returns to AVAILABLE. Returns 200, or 409 unless the reservation is CONFIRMED."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Payment Service",
      "item": [
        {
          "name": "Create Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationId\": 1,\n  \"userId\": 1,\n  \"amount\": 500,\n  \"paymentMethod\": \"CARD\",\n  \"cardNumber\": \"4111 1111 1111 1111\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments"
              ]
            },
            "description": "Process a payment. Requires an existing reservation in the Parking Service. Card 4111 1111 1111 1111 succeeds (status SUCCESS, 201). Cards ending in 0002 are declined (status FAILED). The full card number is never stored - only a masked form is returned. Repeating a successful payment for the same reservation returns 409."
          },
          "response": []
        },
        {
          "name": "Get Payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/{{paymentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "{{paymentId}}"
              ]
            },
            "description": "Retrieve a single payment transaction by id. Returns 200, or 404 if not found."
          },
          "response": []
        },
        {
          "name": "Get Reservation Payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/reservation/{{reservationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "reservation",
                "{{reservationId}}"
              ]
            },
            "description": "List all payment attempts (SUCCESS and FAILED) for a reservation. Returns 200 with an array."
          },
          "response": []
        },
        {
          "name": "Get User Payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/user/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "user",
                "{{userId}}"
              ]
            },
            "description": "List all payment transactions belonging to a user. Returns 200 with an array."
          },
          "response": []
        },
        {
          "name": "Get Receipt",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/{{paymentId}}/receipt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "{{paymentId}}",
                "receipt"
              ]
            },
            "description": "Get the digital receipt for a SUCCESS payment. Returns 200 with receiptId, transactionId, reservationId, userId, amount, paymentMethod, paymentStatus, paymentDate. Returns 404 for failed/pending payments."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Duplicate User",
